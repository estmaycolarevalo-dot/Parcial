<?xml version="1.0"?>
<!--
  ============================================================================
  MAQUETA_CLASIFICADOR.URDF
  ============================================================================
  Basado en el archivo base "maqueta.urdf" entregado por el docente
  (fabrica_estable_v3). Se añade el módulo diferencial del grupo:

     "Analizador y organizador de múltiples monedas por medio de YOLO
      y conexión I2C de ESP32" -> ¿Moneda de Colombia, de otro país,
      o es un botón?

  Elementos nuevos agregados sobre la banda superior (cinta_seg1):
    - estacion_soporte / estacion_camara : poste + carcasa que representa
      el módulo de visión (cámara + ESP32-CAM/Raspberry corriendo YOLO)
      que en el sistema real se conecta por I2C al ESP32 principal.
    - led_colombia / led_extranjera / led_boton : 3 indicadores LED que
      se encienden según la clase detectada (cambian de color en
      tiempo real desde el script de Python con changeVisualShape).
    - caja_colombia / caja_extranjera / caja_boton : las 3 bandejas de
      salida donde el sistema organiza cada moneda según su clase.
  ============================================================================
-->
<robot name="fabrica_estable_v3_clasificador">

  <!-- ============ MATERIALES (heredados del archivo base) ============ -->
  <material name="blue_metal"><color rgba="0.05 0.15 0.35 1.0"/></material>
  <material name="black_rubber"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="white_machine"><color rgba="0.95 0.95 0.98 1.0"/></material>
  <material name="base_material"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="brazo1_material"><color rgba="0.2 0.6 0.8 1"/></material>
  <material name="brazo2_material"><color rgba="0.9 0.5 0.1 1"/></material>
  <material name="pinza_material"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="dedo_material"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="carro_material"><color rgba="0.1 0.3 0.6 1"/></material>

  <!-- ============ MATERIALES NUEVOS (módulo diferencial) ============ -->
  <material name="colombia_material"><color rgba="0.05 0.75 0.25 1.0"/></material>
  <material name="extranjera_material"><color rgba="0.15 0.35 0.9 1.0"/></material>
  <material name="boton_material"><color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="led_apagado"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="camara_lente"><color rgba="0.02 0.02 0.02 1.0"/></material>

  <!-- ========================================== -->
  <!-- SEGMENTO 1: CINTA SUPERIOR (Horizontal)     -->
  <!-- ========================================== -->
  <link name="cinta_seg1">
    <visual>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue_metal"/>
    </visual>
    <visual>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <!-- Rodillos/patas de soporte (dan el aspecto de banda transportadora real) -->
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="1.8 0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="1.8 -0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="0 0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="0 -0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="-1.8 0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <origin xyz="-1.8 -0.15 -0.25" rpy="0 0 0"/>
      <material name="black_rubber"/>
    </visual>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="10.0" ixy="0.0" ixz="0.0" iyy="10.0" iyz="0.0" izz="1.5"/>
    </inertial>
  </link>

  <link name="base_planta">
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/>
    </inertial>
  </link>

  <!-- 1. CINTA SUPERIOR: la misma posición usada en el archivo base -->
  <joint name="j_cinta_seg1" type="fixed">
    <parent link="base_planta"/>
    <child link="cinta_seg1"/>
    <origin xyz="1.0 0.0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- MÓDULO DIFERENCIAL: ESTACIÓN DE VISIÓN (YOLO + ESP32 I2C) -->
  <!-- Ubicada sobre la cinta superior, en x=0.3 (coords de mundo) -->
  <!-- ========================================================= -->

  <link name="estacion_soporte">
    <visual>
      <geometry><cylinder radius="0.03" length="1.0"/></geometry>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <material name="base_material"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="j_estacion_soporte" type="fixed">
    <parent link="base_planta"/>
    <child link="estacion_soporte"/>
    <!-- x=0.3 -> justo sobre la cinta superior, cerca del inicio -->
    <origin xyz="0.3 0.0 0.65" rpy="0 0 0"/>
  </joint>

  <link name="estacion_camara">
    <!-- Carcasa: ESP32-CAM / módulo de visión -->
    <visual>
      <geometry><box size="0.25 0.25 0.15"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="white_machine"/>
    </visual>
    <!-- Lente de la cámara apuntando hacia abajo, a la banda -->
    <visual>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <material name="camara_lente"/>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="j_estacion_camara" type="fixed">
    <parent link="estacion_soporte"/>
    <child link="estacion_camara"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- 3 LEDs indicadores: se colorean en tiempo real desde Python
       según la clase devuelta por el clasificador (YOLO real a futuro) -->
  <link name="led_colombia">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="led_apagado"/>
    </visual>
  </link>
  <joint name="j_led_colombia" type="fixed">
    <parent link="estacion_camara"/>
    <child link="led_colombia"/>
    <origin xyz="-0.08 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="led_extranjera">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="led_apagado"/>
    </visual>
  </link>
  <joint name="j_led_extranjera" type="fixed">
    <parent link="estacion_camara"/>
    <child link="led_extranjera"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="led_boton">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="led_apagado"/>
    </visual>
  </link>
  <joint name="j_led_boton" type="fixed">
    <parent link="estacion_camara"/>
    <child link="led_boton"/>
    <origin xyz="0.08 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 3 BANDEJAS DE SALIDA (organización final de las monedas)   -->
  <!-- Alineadas en x=0.3 (misma x que la estación), separadas en y -->
  <!-- ========================================================= -->

  <link name="caja_colombia">
    <visual>
      <geometry><box size="0.3 0.3 0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="colombia_material"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="j_caja_colombia" type="fixed">
    <parent link="base_planta"/>
    <child link="caja_colombia"/>
    <origin xyz="0.3 0.6 0.0" rpy="0 0 0"/>
  </joint>

  <link name="caja_extranjera">
    <visual>
      <geometry><box size="0.3 0.3 0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="extranjera_material"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="j_caja_extranjera" type="fixed">
    <parent link="base_planta"/>
    <child link="caja_extranjera"/>
    <origin xyz="0.3 0.95 0.0" rpy="0 0 0"/>
  </joint>

  <link name="caja_boton">
    <visual>
      <geometry><box size="0.3 0.3 0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="boton_material"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="j_caja_boton" type="fixed">
    <parent link="base_planta"/>
    <child link="caja_boton"/>
    <origin xyz="0.3 1.3 0.0" rpy="0 0 0"/>
  </joint>

</robot>
